{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "env": { "NEXT_DIST_DIR": ".next-preview" }
    },
    {
      "name": "Next.js Dev (Network)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:network"],
      "port": 3000
    },
    {
      "name": "Next.js Production Preview",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["start"],
      "port": 3000
    }
  ]
}
