# ─────────────────────────────────────────────────────────────────────────────
# Pumpline — Supabase environment
#
# 1. Create a project at https://supabase.com  (Region: choose one near India,
#    e.g. Mumbai / ap-south-1).
# 2. Project Settings → API → copy the values below.
# 3. Authentication → Providers → Email: enable it. For the MVP, turn OFF
#    "Confirm email" so onboarding is immediate (or wire an email-confirm flow).
# 4. SQL Editor → paste supabase/migrations/0001_init.sql → Run.
# 5. Copy this file to .env.local and fill in the values.
# ─────────────────────────────────────────────────────────────────────────────

# Project URL — Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co

# Public anon key — Settings → API → Project API keys → anon / public.
# Safe to expose to the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — Settings → API → Project API keys → service_role.
# SERVER ONLY. Bypasses RLS. Never expose to the browser, never commit .env.local.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# ── Razorpay (Phase 3 — leave blank for now) ─────────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
